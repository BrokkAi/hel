ARG NODE_IMAGE=docker.io/library/node:24-trixie
# Pinned to the same compiler as rust-toolchain.toml. A floating `rust:1`
# tag would drift away from the pin, and rustup would then download the
# pinned toolchain on the first cargo run without the musl target and
# components this image adds below. Bump both together.
ARG RUST_IMAGE=docker.io/library/rust:1.96.0-trixie

FROM ${NODE_IMAGE} AS node
FROM ${RUST_IMAGE}

LABEL org.opencontainers.image.title="Hel agent development environment" \
      org.opencontainers.image.source="https://github.com/BrokkAi/hel"

# The Node image and Rust image share the Trixie base. Copying /usr/local
# brings in Node, npm, npx, Corepack, and the headers needed by native modules.
COPY --from=node /usr/local/ /usr/local/

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        fd-find \
        file \
        git \
        gh \
        jq \
        less \
        libssl-dev \
        musl-tools \
        openjdk-25-jdk-headless \
        openssh-client \
        patch \
        pkg-config \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        sudo \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Keep these in lockstep with bridge_launch() in src/hel_controller/worker_binary.rs. Kimi is
# intentionally left to Hel's official on-demand installer because that path is
# not version-pinned yet.
RUN npm install --global --no-audit --no-fund \
        @agentclientprotocol/codex-acp@1.6.2 \
        @agentclientprotocol/claude-agent-acp@0.68.0 \
        @deepseek-ai/dsh@0.1.1-rc.2 \
        dsh-acp-server@0.10.0 \
    && npm cache clean --force

# Buildx sets TARGETARCH per platform; the dpkg fallback keeps a plain
# single-arch `podman build` working.
ARG TARGETARCH
ARG CARGO_NEXTEST_VERSION=0.9.143
RUN ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "$ARCH" in \
        amd64) \
            MUSL=x86_64-unknown-linux-musl; \
            NEXTEST_SHA256=6d891c18105ec2d33f6e441a4f92b7ccab47ba263e22055c8bb66884243f3389 \
            ;; \
        arm64) \
            MUSL=aarch64-unknown-linux-musl; \
            NEXTEST_SHA256=0560ce0ce017f368c54b5db86588370fc03b470985490fa81200e62a657dda05 \
            ;; \
        *) echo "unsupported arch $ARCH" >&2; exit 1 ;; \
    esac \
    && rustup component add clippy rustfmt \
    && rustup target add "$MUSL" \
    && NEXTEST_ARCHIVE="cargo-nextest-${CARGO_NEXTEST_VERSION}-${MUSL}.tar.gz" \
    && NEXTEST_URL="https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${CARGO_NEXTEST_VERSION}/${NEXTEST_ARCHIVE}" \
    && curl --fail --location --silent --show-error "$NEXTEST_URL" --output /tmp/cargo-nextest.tar.gz \
    && echo "$NEXTEST_SHA256  /tmp/cargo-nextest.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/cargo-nextest.tar.gz -C /usr/local/cargo/bin cargo-nextest \
    && rm /tmp/cargo-nextest.tar.gz \
    && install -d /usr/share/doc/cargo-nextest \
    && curl --fail --location --silent --show-error \
        "https://raw.githubusercontent.com/nextest-rs/nextest/cargo-nextest-${CARGO_NEXTEST_VERSION}/LICENSE-APACHE" \
        --output /usr/share/doc/cargo-nextest/LICENSE-APACHE \
    && curl --fail --location --silent --show-error \
        "https://raw.githubusercontent.com/nextest-rs/nextest/cargo-nextest-${CARGO_NEXTEST_VERSION}/LICENSE-MIT" \
        --output /usr/share/doc/cargo-nextest/LICENSE-MIT \
    && echo "a60eea817514531668d7e00765731449fe14d059d3249e0bc93b36de45f759f2  /usr/share/doc/cargo-nextest/LICENSE-APACHE" | sha256sum --check --strict \
    && echo "79e1e84378f5cbb0fd3f7314e80d0a02cbb8454247cecee3326c512ed7234797  /usr/share/doc/cargo-nextest/LICENSE-MIT" | sha256sum --check --strict \
    && cargo nextest --version \
    && java --version \
    && javac --version

RUN useradd --create-home --shell /bin/bash hel \
    && mkdir -p /workspace /var/lib/hel \
    && chown -R hel:hel /workspace /var/lib/hel \
    && chmod 0755 /workspace /var/lib/hel

USER hel
ENV HOME=/home/hel \
    SHELL=/bin/bash
WORKDIR /workspace

# Hel overrides the command with the same keepalive, but retaining it here also
# makes the image convenient to inspect directly.
STOPSIGNAL SIGKILL
CMD ["sleep", "infinity"]
